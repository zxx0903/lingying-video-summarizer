{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit Demo",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/lingying/app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8501"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "CLI Demo",
      "type": "debugpy",
      "request": "launch",
      "module": "lingying.cli",
      "args": [
        "--input",
        "${workspaceFolder}/data/input/demo_lecture.mp4",
        "--out",
        "${workspaceFolder}/outputs/cli_demo",
        "--target",
        "90",
        "--no-asr"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
